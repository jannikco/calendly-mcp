{
  "id": "calendly",
  "name": "Calendly",
  "version": "0.1.0",
  "baseUrl": "https://api.calendly.com",
  "auth": {
    "type": "bearer",
    "env": "CALENDLY_ACCESS_TOKEN"
  },
  "tools": [
    {
      "name": "calendly_get_current_user",
      "description": "Read the authenticated user URI needed for event-type lookup.",
      "method": "GET",
      "path": "/users/me",
      "readOnly": true,
      "approvalRequired": false,
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "bindings": {
        "path": [],
        "query": {},
        "body": {}
      },
      "sampleArguments": {},
      "evidence": {
        "state": "documented",
        "providerLiveValidation": "not-run"
      },
      "provenance": [
        "https://developer.calendly.com/openapi/calendly-api.yaml"
      ]
    },
    {
      "name": "calendly_list_event_types",
      "description": "Read event types owned by the chosen authenticated user URI.",
      "method": "GET",
      "path": "/event_types",
      "readOnly": true,
      "approvalRequired": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "user": {
            "type": "string",
            "pattern": "^https://api\\.calendly\\.com/users/[A-Za-z0-9-]+$"
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "user"
        ],
        "additionalProperties": false
      },
      "bindings": {
        "path": [],
        "query": {
          "user": "user",
          "count": "count"
        },
        "body": {}
      },
      "sampleArguments": {
        "user": "https://api.calendly.com/users/00000000-0000-4000-8000-000000000001",
        "count": 10
      },
      "evidence": {
        "state": "documented",
        "providerLiveValidation": "not-run"
      },
      "provenance": [
        "https://developer.calendly.com/openapi/calendly-api.yaml"
      ]
    },
    {
      "name": "calendly_create_single_use_link",
      "description": "Create a scheduling link limited to one event; plan/access requirements apply.",
      "method": "POST",
      "path": "/scheduling_links",
      "readOnly": false,
      "approvalRequired": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "pattern": "^https://api\\.calendly\\.com/event_types/[A-Za-z0-9-]+$"
          }
        },
        "required": [
          "owner"
        ],
        "additionalProperties": false
      },
      "bindings": {
        "path": [],
        "query": {},
        "body": {
          "owner": "owner"
        }
      },
      "sampleArguments": {
        "owner": "https://api.calendly.com/event_types/00000000-0000-4000-8000-000000000001"
      },
      "evidence": {
        "state": "documented",
        "providerLiveValidation": "not-run"
      },
      "body": {
        "owner_type": "EventType",
        "max_event_count": 1
      },
      "provenance": [
        "https://developer.calendly.com/openapi/calendly-api.yaml"
      ]
    }
  ],
  "workflow": {
    "name": "Calendly authorized workflow",
    "description": "Identify the authenticated scheduler, inspect event types and explicitly create a one-use scheduling link.",
